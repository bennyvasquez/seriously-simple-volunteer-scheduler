# Production settings for an SSVS server. docs/install.md (step 4) walks through this: copy this file to /var/www/ssvs/.env, fill in DB_PASSWORD, APP_URL and the mail settings, and run `php artisan key:generate --force` to set APP_KEY. Then run `php artisan ssvs:check-install`, which checks the result and says what's still wrong. The development template is .env.example in the repository root; this file keeps its order and comments so the two are easy to compare.
APP_NAME="SSVS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Your site's address, starting with https:// and with no path or trailing slash.
APP_URL=https://ssvs.example.org

# Only for an HTTP proxy or load balancer in front of the app (nginx using proxy_pass, Caddy, HAProxy, a cloud load balancer): a comma-separated list of its addresses, whose X-Forwarded-For and X-Forwarded-Proto headers are believed. Leave empty for nginx with PHP-FPM, which has no proxy. "*" trusts every sender, must be the whole value, and is only for an app reachable only through the proxy.
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB on the same server, reached through its socket. MariaDB runs with skip-networking, so nothing outside the server can reach it. Create the database and user as the install guide describes, and use the password you chose for DB_PASSWORD.
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_SOCKET=/var/lib/mysql/mysql.sock
DB_DATABASE=ssvs
DB_USERNAME=ssvs
DB_PASSWORD=CHANGE-ME-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# SSVS sends email as it goes and queues nothing, so there is no queue worker to run.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Your own mail provider's SMTP (Simple Mail Transfer Protocol) details. Never use the log mailer in production, because nobody would get any email. MAIL_FROM_ADDRESS must be an address on a domain you control (with SPF and DKIM set up so mail arrives), and `php artisan ssvs:check-install` refuses the example.org address until you change it. MAIL_HOST, MAIL_USERNAME and MAIL_PASSWORD are left for you to fill in.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="volunteers@example.org"
MAIL_FROM_NAME="${APP_NAME}"
