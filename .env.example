# This file is for local development. A production server's .env needs APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning, SESSION_SECURE_COOKIE=true and a real MAIL_MAILER (smtp, say, never log). In production the app turns debug off and refuses to send email through the log mailer, whatever .env says.
APP_NAME="SSVS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Only for an HTTP proxy or load balancer in front of the app (nginx using proxy_pass, Caddy, HAProxy, a cloud load balancer): a comma-separated list of its addresses, whose X-Forwarded-For and X-Forwarded-Proto headers are believed. Leave empty for nginx with PHP-FPM, which has no proxy. "*" trusts every sender, must be the whole value, and is only for an app reachable only through the proxy.
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development values matching compose.yaml. Real servers use their own credentials.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ssvs
DB_USERNAME=ssvs
DB_PASSWORD=ssvs-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development values matching compose.yaml. Real servers use their own mail provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="volunteers@example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
